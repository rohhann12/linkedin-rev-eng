{
  "name": "linkedin-profile-api",
  "version": "1.0.0",
  "private": true,
  "description": "Hosted API that resolves a LinkedIn profile URL into structured JSON",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "capture": "tsx scripts/capture-fixture.ts",
    "harvest": "tsx scripts/harvest-query-ids.ts",
    "session:check": "tsx scripts/session-check.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "optionalDependencies": {
    "@upstash/redis": "^1.34.3"
  }
}
