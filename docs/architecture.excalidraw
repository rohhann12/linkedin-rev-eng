    { "id": "note_sess", "type": "text", "x": 660, "y": 225, "width": 420, "height": 45, "angle": 0, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 6006, "version": 1, "versionNonce": 6006, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "Login once on a trusted IP. After that every\nSet-Cookie is merged back — session self-renews.", "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "Login once on a trusted IP. After that every\nSet-Cookie is merged back — session self-renews.", "lineHeight": 1.25 },

    { "id": "note_limit", "type": "text", "x": 40, "y": 560, "width": 940, "height": 70, "angle": 0, "strokeColor": "#666666", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "groupIds": [], "frameId": null, "roundness": null, "seed": 7001, "version": 1, "versionNonce": 7001, "isDeleted": false, "boundElements": [], "updated": 1, "link": null, "locked": false, "text": "The limit is not the parser — it is visibility.\nOut-of-network profiles return the \"LinkedIn Member\" placeholder → PROFILE_NOT_VISIBLE.\nCommercial Use Limit caps distinct views per account per month → cache and rate limit exist for this.", "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "containerId": null, "originalText": "The limit is not the parser — it is visibility.\nOut-of-network profiles return the \"LinkedIn Member\" placeholder → PROFILE_NOT_VISIBLE.\nCommercial Use Limit caps distinct views per account per month → cache and rate limit exist for this.", "lineHeight": 1.25 }
