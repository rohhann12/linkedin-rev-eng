# --- LinkedIn session (required) -------------------------------------------
# Copied out of an authenticated browser session. NEVER commit real values.
# LINKEDIN_JSESSIONID doubles as the CSRF token value.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID="ajax:0000000000000000000"

# Optional: a full cookie header string. When set it takes precedence over the
# two values above. Preferred in practice, because LinkedIn's edge also wants
# the lidc/bcookie affinity cookies.
LINKEDIN_COOKIE=

# --- API access control ----------------------------------------------------
# Comma-separated accepted x-api-key values. Empty means open (local dev only).
API_KEYS=
# Bearer token guarding /v1/admin/* (session reseed, cache purge).
ADMIN_TOKEN=

# --- Behaviour -------------------------------------------------------------
# Where the rotating cookie jar is persisted. Written 0600. Set to an empty
# string to disable file persistence (then configure a shared cache instead).
SESSION_FILE=.session.json

CACHE_TTL_SECONDS=86400
RATE_LIMIT_PER_MINUTE=20
UPSTREAM_MIN_INTERVAL_MS=1500
FETCH_TIMEOUT_MS=20000
STRATEGY_ORDER=rest,embedded,graphql

# --- Optional: model-assisted rescue when the deterministic mappers fail -----
# Off unless set. See src/linkedin/fetchers/assisted.ts.
INTERFAZE_API_KEY=

# --- Optional shared cache (falls back to an in-process LRU) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
